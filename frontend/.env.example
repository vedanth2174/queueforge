# Browser-visible API origin.
# Local development: leave empty so /api, /health, and /metrics use the Vite
# proxy below.
# Standalone production: set the public QueueForge API origin, for example
# https://api.queueforge.example. The API must allow the dashboard origin via
# CORS. Leave empty only when the deployed API is served from the same origin.
VITE_API_BASE_URL=

# Development-only Vite proxy destination. This is read from the selected Vite
# mode's env file and is not emitted into the browser bundle.
VITE_DEV_API_PROXY_TARGET=http://localhost:3000
