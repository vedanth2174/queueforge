POSTGRES_PASSWORD=your_existing_local_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=queueforge
DB_USER=queueforge
PORT=3000
# Reverse-proxy trust for hosted deployments such as Render. Set to 1 only
# when the app is behind the expected single trusted proxy.
TRUST_PROXY=

# Per-IP POST /api/v1/jobs limit per minute (defaults to 60).
JOB_SUBMISSION_RATE_LIMIT=60
